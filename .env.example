# ==============================================================================
# NelovMallickIITD CBT Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your Supabase project credentials.
# If these variables are not provided, the platform will automatically run in
# local zero-dependency offline mode (using Web Crypto SHA-256 and client store).
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=

# Supabase Anonymous Client Public Key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=
