# ==============================================================================
# NelovMallickIITD CBT Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env (or .env.local) and fill in your Supabase credentials.
# Never commit .env or .env.local to Git.
# If these variables are omitted in local dev, the app falls back gracefully to
# offline localStorage mode with a non-blocking banner.
# ==============================================================================

# Vite Frontend Credentials (Primary)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Next.js-compatible aliases (also supported automatically by Vite)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
